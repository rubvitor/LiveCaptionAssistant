<Window x:Class="LiveCaptionAssistant.App.Views.SettingsWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:vm="clr-namespace:LiveCaptionAssistant.App.ViewModels"
        mc:Ignorable="d"
        d:DataContext="{d:DesignInstance Type=vm:SettingsViewModel, IsDesignTimeCreatable=False}"
        Title="Settings - Live Caption Assistant"
        Width="640" Height="780" MinWidth="520" MinHeight="480"
        WindowStartupLocation="CenterOwner" Topmost="True" ShowInTaskbar="False"
        FontFamily="{StaticResource UiFont}">
    <DockPanel Margin="24,12,24,20">
        <StackPanel DockPanel.Dock="Bottom" Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,16,0,0">
            <Button Content="Cancel" MinWidth="96" Margin="0,0,8,0" IsCancel="True" Command="{Binding CancelCommand}" />
            <Button Content="Save" MinWidth="96" IsDefault="True" Style="{StaticResource PrimaryButtonStyle}" Command="{Binding SaveCommand}" />
        </StackPanel>

        <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled" Padding="0,0,12,0">
            <StackPanel>
                <TextBlock Text="Audio" Style="{StaticResource SettingsHeaderStyle}" />
                <TextBlock Text="Meeting audio - the output device your meeting app plays through" Style="{StaticResource SettingsLabelStyle}" />
                <ComboBox ItemsSource="{Binding OutputDevices}" SelectedItem="{Binding SelectedOutputDevice}" DisplayMemberPath="Label" />
                <TextBlock Text="Automatic captures speakers and headsets, including devices connected after Start. If you choose one device, it must match the speaker selected in Google Meet or your meeting app."
                           Style="{StaticResource SettingsLabelStyle}" />
                <CheckBox Content="Also transcribe my microphone (shown as &quot;Me&quot;)" IsChecked="{Binding CaptureMicrophone}" Margin="0,14,0,0" />
                <TextBlock Text="Microphone" Style="{StaticResource SettingsLabelStyle}" />
                <ComboBox ItemsSource="{Binding Microphones}" SelectedItem="{Binding SelectedMicrophone}" DisplayMemberPath="Label"
                          IsEnabled="{Binding CaptureMicrophone}" />

                <TextBlock Text="Transcription" Style="{StaticResource SettingsHeaderStyle}" />
                <TextBlock Text="Speech is transcribed on this PC with Whisper - free, offline, no tokens used. Larger models are more accurate but need more processing power."
                           Style="{StaticResource SettingsLabelStyle}" />
                <ComboBox ItemsSource="{Binding SpeechModels}" SelectedItem="{Binding SelectedSpeechModel}" DisplayMemberPath="Label" />
                <CheckBox Content="Use GPU acceleration (Vulkan) - applies after restarting the app" IsChecked="{Binding UseGpuAcceleration}" Margin="0,14,0,0" />
                <CheckBox Content="Show live captions while someone is still speaking" IsChecked="{Binding LivePartialCaptions}" Margin="0,8,0,0" />

                <TextBlock Text="AI answers" Style="{StaticResource SettingsHeaderStyle}" />
                <CheckBox Content="Answer questions from the other participants automatically" IsChecked="{Binding AutoAnswer}" />
                <TextBlock Text="Answer language" Style="{StaticResource SettingsLabelStyle}" />
                <ComboBox ItemsSource="{Binding AnswerLanguages}" SelectedItem="{Binding SelectedAnswerLanguage}" DisplayMemberPath="Label" />
                <TextBlock Text="Answer style" Style="{StaticResource SettingsLabelStyle}" />
                <ComboBox ItemsSource="{Binding AnswerStyles}" SelectedItem="{Binding SelectedAnswerStyle}" DisplayMemberPath="Label" />
                <TextBlock Text="Your background - résumé, current role, the job description... The AI uses it to tailor answers and never invents experience beyond it."
                           Style="{StaticResource SettingsLabelStyle}" />
                <TextBox Text="{Binding UserBackground, UpdateSourceTrigger=PropertyChanged}" AcceptsReturn="True" TextWrapping="Wrap"
                         MinHeight="150" MaxHeight="280" VerticalScrollBarVisibility="Auto" VerticalContentAlignment="Top" />

                <TextBlock Text="ChatGPT account" Style="{StaticResource SettingsHeaderStyle}" />
                <TextBlock Text="{Binding AccountSummary}" TextWrapping="Wrap" />
                <TextBlock Text="{Binding AccountMessage}" Style="{StaticResource SettingsLabelStyle}" Margin="0,4,0,0" />
                <WrapPanel Margin="0,8,0,0">
                    <Button Content="Sign out" Margin="0,0,8,8" Command="{Binding SignOutCommand}" />
                    <Button Content="Forget account" Margin="0,0,8,8" Command="{Binding ForgetAccountCommand}" />
                    <Button Content="Manage ChatGPT usage" Margin="0,0,8,8" Command="{Binding OpenUsageCommand}" />
                </WrapPanel>

                <TextBlock Text="Shortcuts" Style="{StaticResource SettingsHeaderStyle}" />
                <TextBlock Text="{Binding ShortcutsDescription}" TextWrapping="Wrap" LineHeight="22" />

                <TextBlock Text="Troubleshooting" Style="{StaticResource SettingsHeaderStyle}" />
                <Button Content="Open logs folder" HorizontalAlignment="Left" Command="{Binding OpenLogsFolderCommand}" />
            </StackPanel>
        </ScrollViewer>
    </DockPanel>
</Window>
