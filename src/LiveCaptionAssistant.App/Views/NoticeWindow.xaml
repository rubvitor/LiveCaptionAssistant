<Window x:Class="LiveCaptionAssistant.App.Views.NoticeWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Width="440" SizeToContent="Height" ResizeMode="NoResize"
        WindowStartupLocation="CenterOwner" Topmost="True" ShowInTaskbar="False"
        FontFamily="{StaticResource UiFont}">
    <StackPanel Margin="24,20,24,20">
        <TextBlock x:Name="HeadingText" FontSize="18" FontWeight="SemiBold" TextWrapping="Wrap" />
        <TextBlock x:Name="MessageText" Margin="0,10,0,0" TextWrapping="Wrap" LineHeight="20" Foreground="{StaticResource TextSecondaryBrush}" />
        <TextBlock x:Name="LinkContainer" Margin="0,10,0,0" Visibility="Collapsed">
            <Hyperlink x:Name="LinkElement" Click="OnLinkClick">
                <Run x:Name="LinkText" />
            </Hyperlink>
        </TextBlock>
        <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,20,0,0">
            <Button x:Name="CancelButton" MinWidth="96" Margin="0,0,8,0" IsCancel="True" Click="OnCancelClick" Visibility="Collapsed" />
            <Button x:Name="ConfirmButton" MinWidth="96" IsDefault="True" Style="{StaticResource PrimaryButtonStyle}" Click="OnConfirmClick" />
        </StackPanel>
    </StackPanel>
</Window>
